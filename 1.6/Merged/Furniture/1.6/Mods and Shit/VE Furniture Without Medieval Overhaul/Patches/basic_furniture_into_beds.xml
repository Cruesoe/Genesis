<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- VE Furniture's Basic furniture (simple beds) folds into Beds; Complex furniture then needs Beds -->
  <Operation Class="PatchOperationSequence">
    <operations>
      <li Class="PatchOperationReplace">
        <success>Always</success>
        <xpath>Defs//*[self::researchPrerequisites or self::prerequisites or self::hiddenPrerequisites]/li[normalize-space(text())="MF_BasicFurniture"]</xpath>
        <value>
          <li>Ferny_Bedroll</li>
        </value>
      </li>
      <li Class="PatchOperationReplace">
        <success>Always</success>
        <xpath>Defs//researchPrerequisite[normalize-space(text())="MF_BasicFurniture"]</xpath>
        <value>
          <researchPrerequisite>Ferny_Bedroll</researchPrerequisite>
        </value>
      </li>
      <li Class="PatchOperationRemove">
        <success>Always</success>
        <xpath>Defs/ResearchProjectDef[defName="MF_BasicFurniture"]</xpath>
      </li>
    </operations>
  </Operation>
</Patch>
