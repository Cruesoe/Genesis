                <RB_Glass>10</RB_Glass>
            </value>
        </match>
        <nomatch Class="PatchOperationAdd">
            <xpath>/Defs/ThingDef[defName="PFS_HoloGlassAutodoor"]/costList</xpath>
            <value>
                <RB_Glass>10</RB_Glass>
            </value>
        </nomatch>
    </Operation>
</Patch>
