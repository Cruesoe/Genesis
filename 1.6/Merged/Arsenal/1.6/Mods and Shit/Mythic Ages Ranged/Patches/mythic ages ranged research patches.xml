<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods><li>Mythic Ages: Megafauna Bestiary</li></mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationReplace">
          <xpath>Defs/ResearchProjectDef[defName="Ferny_CapryakScatterbow"]</xpath>
          <value>
            <VFETribals.TribalResearchProjectDef>
              <defName>Ferny_CapryakScatterbow</defName>
              <label>capryak scatterbow</label>
              <description>Craft horn-backed skirmish bows that trade long-range accuracy for rapid close volleys.</description>
              <baseCost>15</baseCost>
              <tab>VFET_Basics</tab>
              <techLevel>Animal</techLevel>
              <researchViewX>4.00</researchViewX>
              <researchViewY>4.20</researchViewY>
              <prerequisites>
                <li MayRequire="VanillaExpanded.VWETB">Ferny_Sling</li>
                <li>VFET_Bow</li>
              </prerequisites>
            </VFETribals.TribalResearchProjectDef>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/RecipeDef[defName="MA_Make_CapryakScatterbow"]</xpath>
          <value><researchPrerequisite>Ferny_CapryakScatterbow</researchPrerequisite></value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="MA_CapryakScatterbow"]</xpath>
          <value><recipeMaker><researchPrerequisite>Ferny_CapryakScatterbow</researchPrerequisite></recipeMaker></value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>
