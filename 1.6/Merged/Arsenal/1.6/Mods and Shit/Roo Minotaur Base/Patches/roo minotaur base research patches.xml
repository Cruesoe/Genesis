<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="RBME_EpsilonAxe"]/recipeMaker/researchPrerequisite</xpath>
    <value>
      <researchPrerequisite>Ferny_BattleAxe</researchPrerequisite>
    </value>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="RBM_Labrys"]/researchPrerequisites</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="RBM_Labrys"]/researchPrerequisites</xpath>
      <value>
        <researchPrerequisites>
          <li>Ferny_DaneAxe</li>
        </researchPrerequisites>
      </value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="RBM_Labrys"]</xpath>
      <value>
        <researchPrerequisites>
          <li>Ferny_DaneAxe</li>
        </researchPrerequisites>
      </value>
    </nomatch>
  </Operation>
</Patch>
