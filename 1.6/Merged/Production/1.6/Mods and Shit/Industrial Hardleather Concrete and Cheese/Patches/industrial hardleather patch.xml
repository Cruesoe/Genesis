<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Vanilla Factions Expanded - Medieval 2</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>
				<li Class="PatchOperationReplace">
					<success>Always</success>
					<xpath>Defs/ThingDef[defName="talias_EletricLeatherBoilpot"]/researchPrerequisites</xpath>
					<value>
						<researchPrerequisites>
							<li>Electricity</li>
							<li>ComplexClothing</li>
							
						</researchPrerequisites>
					</value>
				</li>
			</operations>
		</match>
	</Operation>

	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Vanilla Factions Expanded - Classical</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>
				<li Class="PatchOperationReplace">
					<success>Always</success>
					<xpath>Defs/ThingDef[defName="talias_EletricConcreteMaker"]/researchPrerequisites</xpath>
					<value>
						<researchPrerequisites>
							<li>Electricity</li>
							<li>VFEC_CementMaking</li>
						</researchPrerequisites>
					</value>
				</li>
			</operations>
		</match>
	</Operation>

</Patch>
