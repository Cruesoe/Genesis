<?xml version="1.0" encoding="utf-8" ?>
<Patch>

  <!-- Other mods' research that optionally requires Progression: Production requires this fork instead -->
  <Operation Class="PatchOperationAttributeSet">
    <success>Always</success>
    <xpath>Defs//*[translate(@MayRequire,'ABCDEFGHIJKLMNOPQRSTUVWXYZ','abcdefghijklmnopqrstuvwxyz')="cruesoe.genesis"]</xpath>
    <attribute>MayRequire</attribute>
    <value>cruesoe.genesis</value>
  </Operation>

</Patch>