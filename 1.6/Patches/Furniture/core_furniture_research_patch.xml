<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<Operation Class="PatchOperationSequence">
		<operations>
			<li Class="PatchOperationRemove">
				<success>Always</success>
				<xpath>/Defs/ThingDef[defName="Sarcophagus" or defName="ChessTable" or defName="Dresser" or defName="EndTable" or defName="PokerTable"]/researchPrerequisites</xpath>
			</li>
			<li Class="PatchOperationAdd">
				<xpath>/Defs/ThingDef[defName="Sarcophagus"]</xpath>
				<value>
					<researchPrerequisites Inherit="False">
						<li>Genesis_Sarcophagus</li>
					</researchPrerequisites>
				</value>
			</li>
			<li Class="PatchOperationAdd">
				<xpath>/Defs/ThingDef[defName="ChessTable"]</xpath>
				<value>
					<researchPrerequisites Inherit="False">
						<li>Genesis_ChessTable</li>
					</researchPrerequisites>
				</value>
			</li>
			<li Class="PatchOperationAdd">
				<xpath>/Defs/ThingDef[defName="Dresser"]</xpath>
				<value>
					<researchPrerequisites Inherit="False">
						<li>ComplexFurniture</li>
						<li>Genesis_Tables</li>
					</researchPrerequisites>
				</value>
			</li>
			<li Class="PatchOperationAdd">
				<xpath>/Defs/ThingDef[defName="EndTable"]</xpath>
				<value>
					<researchPrerequisites Inherit="False">
						<li>ComplexFurniture</li>
						<li>Genesis_Tables</li>
					</researchPrerequisites>
				</value>
			</li>
			<li Class="PatchOperationAdd">
				<xpath>/Defs/ThingDef[defName="PokerTable"]</xpath>
				<value>
					<researchPrerequisites Inherit="False">
						<li>Genesis_PokerTable</li>
					</researchPrerequisites>
				</value>
			</li>
		</operations>
	</Operation>
</Patch>
