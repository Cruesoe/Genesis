<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- Generated from a mapping table: every vanilla, DLC and Medieval 2 project is replaced by a Genesis project. The old project is hidden, finishes with its
       replacement, and its items move to the replacement unless a Genesis project lists them (Genesis.UnlocksItems). Missing DLC projects are skipped. -->
  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/ResearchProjectDef[defName="Pemmican"]</xpath>
    <success>Always</success>
    <value><li Class="Genesis.SupersededResearch"><by>Genesis_Cooking</by></li></value>
  </Operation>
