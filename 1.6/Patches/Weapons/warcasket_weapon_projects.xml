<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod"><mods><li>Vanilla Factions Expanded - Pirates</li></mods><match Class="PatchOperationSequence"><operations>
    <li Class="PatchOperationReplace"><xpath>Defs/ResearchProjectDef[defName="VFEP_WarcasketWeaponry"]/label</xpath><value><label>warcasket autorifle</label></value></li>
    <li Class="PatchOperationReplace"><xpath>Defs/ResearchProjectDef[defName="VFEP_WarcasketWeaponry"]/description</xpath><value><description>Build upscaled automatic rifles designed for warcasket operators.</description></value></li>
    <li Class="PatchOperationReplace"><xpath>Defs/ResearchProjectDef[defName="VFEP_WarcasketWeaponry"]/baseCost</xpath><value><baseCost>600</baseCost></value></li>
    <li Class="PatchOperationAdd"><xpath>Defs/ThingDef[defName="VFEP_Box_Autorifle"]</xpath><value><researchPrerequisites Inherit="False"><li>VFEP_WarcasketWeaponry</li></researchPrerequisites></value></li>
    <li Class="PatchOperationAdd"><xpath>Defs/ThingDef[defName="VFEP_Box_Broadsword"]</xpath><value><researchPrerequisites Inherit="False"><li>Ferny_WarcasketBroadsword</li></researchPrerequisites></value></li>
    <li Class="PatchOperationAdd"><xpath>Defs/ThingDef[defName="VFEP_Box_CombatKnife"]</xpath><value><researchPrerequisites Inherit="False"><li>Ferny_WarcasketBroadsword</li></researchPrerequisites></value></li>
    <li Class="PatchOperationAdd"><xpath>Defs/ThingDef[defName="VFEP_Box_GravityHammer"]</xpath><value><researchPrerequisites Inherit="False"><li>Ferny_WarcasketBroadsword</li></researchPrerequisites></value></li>
    <li Class="PatchOperationAdd"><xpath>Defs/ThingDef[defName="VFEP_Box_GrenadeLauncher"]</xpath><value><researchPrerequisites Inherit="False"><li>Ferny_WarcasketSlugthrower</li></researchPrerequisites></value></li>
    <li Class="PatchOperationAdd"><xpath>Defs/ThingDef[defName="VFEP_Box_HandheldCannon"]</xpath><value><researchPrerequisites Inherit="False"><li>Ferny_WarcasketSlugthrower</li></researchPrerequisites></value></li>
    <li Class="PatchOperationAdd"><xpath>Defs/ThingDef[defName="VFEP_Box_HeavyFlamer"]</xpath><value><researchPrerequisites Inherit="False"><li>Ferny_WarcasketSlugthrower</li><li>BiofuelRefining</li></researchPrerequisites></value></li>
    <li Class="PatchOperationAdd"><xpath>Defs/ThingDef[defName="VFEP_Box_Minigun"]</xpath><value><researchPrerequisites Inherit="False"><li>Ferny_WarcasketSlugthrower</li><li>MultibarrelWeapons</li></researchPrerequisites></value></li>
    <li Class="PatchOperationAdd"><xpath>Defs/ThingDef[defName="VFEP_Box_Slugthrower"]</xpath><value><researchPrerequisites Inherit="False"><li>Ferny_WarcasketSlugthrower</li></researchPrerequisites></value></li>
    <li Class="PatchOperationAdd"><xpath>Defs/ThingDef[defName="VFEP_Box_UraniumSlugRifle"]</xpath><value><researchPrerequisites Inherit="False"><li>Ferny_WarcasketSlugthrower</li><li MayRequire="VanillaExpanded.VWEHW">Ferny_UraniumSlugRifle</li></researchPrerequisites></value></li>
  </operations></match></Operation>
  <Operation Class="PatchOperationFindMod"><mods><li>Vanilla Weapons Expanded - Bioferrite</li></mods><match Class="PatchOperationReplace"><xpath>Defs/ThingDef[defName="VFEP_Box_Warbolter"]/researchPrerequisites</xpath><value><researchPrerequisites Inherit="False"><li>Ferny_WarcasketSlugthrower</li><li>BioferriteIgnition</li></researchPrerequisites></value></match></Operation>
  <Operation Class="PatchOperationFindMod"><mods><li>Vanilla Weapons Expanded - Quickdraw</li></mods><match Class="PatchOperationReplace"><xpath>Defs/ThingDef[defName="VFEP_Box_FoldingGun"]/researchPrerequisites</xpath><value><researchPrerequisites Inherit="False"><li>Ferny_WarcasketSlugthrower</li><li>VWE_Quickdraw</li></researchPrerequisites></value></match></Operation>
  <Operation Class="PatchOperationFindMod"><mods><li>Eltex Weaponry (Continued)</li></mods><match Class="PatchOperationReplace"><xpath>Defs/ThingDef[defName="EW_WC_EltexGreatsword_OnFloor"]/researchPrerequisites</xpath><value><researchPrerequisites Inherit="False"><li>Ferny_WarcasketEltexGreatsword</li></researchPrerequisites></value></match></Operation>
  <Operation Class="PatchOperationFindMod"><mods><li>Eventide Warcasket</li></mods><match Class="PatchOperationReplace"><xpath>Defs/ThingDef[defName="dvd_Box_CollapseWeapon"]/researchPrerequisites</xpath><value><researchPrerequisites Inherit="False"><li>Ferny_WarcasketSunburnCannon</li></researchPrerequisites></value></match></Operation>
</Patch>
