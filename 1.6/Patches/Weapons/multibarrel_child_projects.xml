<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationReplace"><xpath>Defs/ResearchProjectDef[defName="MultibarrelWeapons"]/label</xpath><value><label>minigun</label></value></Operation>
  <Operation Class="PatchOperationReplace"><xpath>Defs/ResearchProjectDef[defName="MultibarrelWeapons"]/description</xpath><value><description>Assemble electrically driven rotary machine guns that deliver a tremendous volume of fire.</description></value></Operation>
  <Operation Class="PatchOperationReplace"><xpath>Defs/ResearchProjectDef[defName="MultibarrelWeapons"]/prerequisites</xpath><value><prerequisites><li MayRequire="VanillaExpanded.VWEHW">VWE_HeavyWeapons</li></prerequisites></value></Operation>
  <Operation Class="PatchOperationRemove"><xpath>Defs/ResearchProjectDef[defName="MultibarrelWeapons"]/hiddenPrerequisites</xpath></Operation>

  <Operation Class="PatchOperationFindMod"><mods><li>Vanilla Factions Expanded - Security</li></mods><match Class="PatchOperationSequence"><operations>
    <li Class="PatchOperationReplace"><xpath>Defs/ThingDef[defName="VFES_Turret_AntiAir"]/researchPrerequisites</xpath><value><researchPrerequisites Inherit="False"><li>Genesis_MinigunTurret</li></researchPrerequisites></value></li>
    <li Class="PatchOperationReplace"><xpath>Defs/ThingDef[defName="VFES_Turret_Minigun"]/researchPrerequisites</xpath><value><researchPrerequisites Inherit="False"><li>Genesis_MinigunTurret</li></researchPrerequisites></value></li>
    <li Class="PatchOperationReplace"><xpath>Defs/ThingDef[defName="VFES_Complex_Minigun"]/researchPrerequisites</xpath><value><researchPrerequisites Inherit="False"><li>Genesis_MinigunTurret</li></researchPrerequisites></value></li>
  </operations></match></Operation>
  <Operation Class="PatchOperationFindMod"><mods><li>Vanilla Arsenal</li></mods><match Class="PatchOperationReplace"><xpath>Defs/ThingDef[defName="DV_Gun_Chaingun"]/recipeMaker/researchPrerequisite</xpath><value><researchPrerequisite>Genesis_HandheldGatlingGun</researchPrerequisite></value></match></Operation>
  <Operation Class="PatchOperationFindMod"><mods><li>Vanilla Weapons Expanded - Frontier</li></mods><match Class="PatchOperationReplace"><xpath>Defs/ThingDef[defName="VWEFT_Gun_HandheldGatlingGun"]/recipeMaker/researchPrerequisite</xpath><value><researchPrerequisite>Genesis_HandheldGatlingGun</researchPrerequisite></value></match></Operation>
  <Operation Class="PatchOperationFindMod"><mods><li>Vanilla Weapons Expanded - Heavy Weapons</li></mods><match Class="PatchOperationReplace"><xpath>Defs/ThingDef[defName="VWE_Gun_SwarmMissileLauncher"]/recipeMaker/researchPrerequisite</xpath><value><researchPrerequisite>Genesis_SwarmMissileLauncher</researchPrerequisite></value></match></Operation>
  <Operation Class="PatchOperationFindMod"><mods><li>Rimpack Joyride</li></mods><match Class="PatchOperationReplace"><xpath>Defs/ThingDef[defName="Rimride_Pack"]/recipeMaker/researchPrerequisite</xpath><value><researchPrerequisite>Genesis_TwinMinigunBackpack</researchPrerequisite></value></match></Operation>
</Patch>
