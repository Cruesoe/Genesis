<?xml version="1.0" encoding="utf-8" ?>
<Patch>


<!-- Repurpose the original basic factories project -->

<Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>Defs/ResearchProjectDef[defName="VFE_BasicFactories"]/label</xpath>
    <value>
        <label>Conveyor belts</label>
    </value>
</Operation>
<Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>Defs/ResearchProjectDef[defName="VFE_BasicFactories"]/description</xpath>
    <value>
        <description>Build automated transport belts for efficiently transporting materials around the colony.</description>
    </value>
</Operation>
<Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>Defs/ResearchProjectDef[defName="VFE_BasicFactories"]/baseCost</xpath>
    <value>
        <baseCost>1500</baseCost>
    </value>
</Operation>


<!-- Repurpose the original complex factories project; the factory booster and heatsink keep it as their research -->

<Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>Defs/ResearchProjectDef[defName="VFE_ComplexFactories"]/label</xpath>
    <value>
        <label>Underground conveyor belts</label>
    </value>
</Operation>
<Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>Defs/ResearchProjectDef[defName="VFE_ComplexFactories"]/description</xpath>
    <value>
        <description>Build automated transport belts that can tunnel underground and back up for more complex logistics networks, plus factory boosters and heatsinks that link with nearby factory machines.</description>
    </value>
</Operation>
<Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>Defs/ResearchProjectDef[defName="VFE_ComplexFactories"]/baseCost</xpath>
    <value>
        <baseCost>2500</baseCost>
    </value>
</Operation>

<Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>Defs/ResearchProjectDef[defName="VFE_ComplexFactories"]/researchViewX</xpath>
    <value>
        <researchViewX>6.00</researchViewX>
    </value>
</Operation>

<Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>Defs/ResearchProjectDef[defName="VFE_ComplexFactories"]/researchViewY</xpath>
    <value>
        <researchViewY>4.20</researchViewY>
    </value>
</Operation>


