<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<Operation Class="PatchOperationConditional">
		<success>Always</success>
		<xpath>Defs/ThingDef[defName="Building_OutfitStand"]/researchPrerequisites</xpath>
		<match Class="PatchOperationReplace">
			<xpath>Defs/ThingDef[defName="Building_OutfitStand"]/researchPrerequisites</xpath>
			<value>
				<researchPrerequisites Inherit="false">
					<li>Genesis_Shelves</li>
					<li MayRequire="oskarpotocki.vfe.tribals">VFET_Furniture</li>
				</researchPrerequisites>
			</value>
		</match>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="Building_OutfitStand"]</xpath>
			<value>
				<researchPrerequisites Inherit="false">
					<li>Genesis_Shelves</li>
					<li MayRequire="oskarpotocki.vfe.tribals">VFET_Furniture</li>
				</researchPrerequisites>
			</value>
		</nomatch>
	</Operation>

	<Operation Class="PatchOperationConditional">
		<success>Always</success>
		<xpath>Defs/ThingDef[defName="Building_KidOutfitStand"]</xpath>
		<match Class="PatchOperationConditional">
			<success>Always</success>
			<xpath>Defs/ThingDef[defName="Building_KidOutfitStand"]/researchPrerequisites</xpath>
			<match Class="PatchOperationReplace">
				<xpath>Defs/ThingDef[defName="Building_KidOutfitStand"]/researchPrerequisites</xpath>
				<value>
					<researchPrerequisites Inherit="false">
						<li>Genesis_Shelves</li>
						<li MayRequire="oskarpotocki.vfe.tribals">VFET_Furniture</li>
					</researchPrerequisites>
				</value>
			</match>
			<nomatch Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[defName="Building_KidOutfitStand"]</xpath>
				<value>
					<researchPrerequisites Inherit="false">
						<li>Genesis_Shelves</li>
						<li MayRequire="oskarpotocki.vfe.tribals">VFET_Furniture</li>
					</researchPrerequisites>
				</value>
			</nomatch>
		</match>
	</Operation>
</Patch>
