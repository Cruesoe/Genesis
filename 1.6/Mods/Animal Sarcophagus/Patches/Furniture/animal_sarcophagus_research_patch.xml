<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<Operation Class="PatchOperationSequence">
		<operations>
			<li Class="PatchOperationRemove">
				<success>Always</success>
				<xpath>/Defs/ThingDef[defName="Animal_Sarcophagus" or defName="Animal_Sarcophagus_Large"]/researchPrerequisites</xpath>
			</li>
			<li Class="PatchOperationAdd">
				<xpath>/Defs/ThingDef[defName="Animal_Sarcophagus" or defName="Animal_Sarcophagus_Large"]</xpath>
				<value>
					<researchPrerequisites Inherit="False">
						<li>Genesis_Sarcophagus</li>
					</researchPrerequisites>
				</value>
			</li>
		</operations>
	</Operation>
</Patch>
