<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<Operation Class="PatchOperationRemove">
		<success>Always</success>
		<xpath>/Defs/ThingDef[defName="PFK_Bunting" or defName="PFK_BuntingAb" or defName="PFK_BuntingB" or defName="PFK_Mobile" or defName="PFK_Curtain" or defName="PFK_BigCurtain"]/researchPrerequisites</xpath>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>/Defs/ThingDef[defName="PFK_Bunting" or defName="PFK_BuntingAb" or defName="PFK_BuntingB"]</xpath>
		<value>
			<researchPrerequisites Inherit="False">
				<li>Genesis_Crib</li>
			</researchPrerequisites>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>/Defs/ThingDef[defName="PFK_Mobile"]</xpath>
		<value>
			<researchPrerequisites Inherit="False">
				<li>Genesis_Crib</li>
			</researchPrerequisites>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>/Defs/ThingDef[defName="PFK_Curtain" or defName="PFK_BigCurtain"]</xpath>
		<value>
			<researchPrerequisites Inherit="False">
				<li>ComplexFurniture</li>
				<li MayRequire="oskarpotocki.vfe.tribals">VFET_Furniture</li>
			</researchPrerequisites>
		</value>
	</Operation>
</Patch>
