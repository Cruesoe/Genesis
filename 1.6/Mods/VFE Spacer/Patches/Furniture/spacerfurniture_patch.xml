<?xml version='1.0' encoding='utf-8'?>
<Patch>
	<Operation Class="PatchOperationReplace">
		<success>Always</success>
		<xpath>Defs/ThingDef[@Name="VFES_InteractiveTableBase"]/researchPrerequisites</xpath>
		<value>
			<researchPrerequisites>
				<li>SpacerElectronics</li>
				<li>Fabrication</li>
			</researchPrerequisites>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<success>Always</success>
		<xpath>Defs/ThingDef[defName="Spacer_OutdoorLamp"]/researchPrerequisites</xpath>
		<value>
			<researchPrerequisites>
				<li>SpacerElectronics</li>
				<li>Fabrication</li>
			</researchPrerequisites>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<success>Always</success>
		<xpath>Defs/ResearchProjectDef[defName="SpacerFurniture"]/label</xpath>
		<value>
			<label>advanced bedrooms</label>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<success>Always</success>
		<xpath>Defs/ThingDef[defName="Seat_AdvChair"]/researchPrerequisites</xpath>
		<value>
			<researchPrerequisites>
				<li>SpacerFurniture</li>
				<li>Fabrication</li>
				<li>Genesis_Couches</li>
			</researchPrerequisites>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<success>Always</success>
		<xpath>Defs/ThingDef[defName="VFES_ModernArmchair"]/researchPrerequisites</xpath>
		<value>
			<researchPrerequisites>
				<li>SpacerFurniture</li>
				<li>Genesis_Couches</li>
			</researchPrerequisites>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<success>Always</success>
		<xpath>Defs/ThingDef[defName="VFES_ModernCouch"]/researchPrerequisites</xpath>
		<value>
			<researchPrerequisites>
				<li>SpacerFurniture</li>
				<li>Genesis_Couches</li>
			</researchPrerequisites>
		</value>
	</Operation>



<!-- Ergonomic bed research prerequisite for advanced bedrooms -->
	<Operation Class="PatchOperationConditional">
		<xpath>/Defs/ResearchProjectDef[defName="SpacerFurniture"]/prerequisites</xpath>
		<match Class="PatchOperationAdd">
			<xpath>/Defs/ResearchProjectDef[defName="SpacerFurniture"]/prerequisites</xpath>
			<value>
				<li>MF_ModernFurniture</li>
				<li>Genesis_ClothBeds</li>
			</value>
		</match>
		<nomatch Class="PatchOperationAdd">
			<xpath>/Defs/ResearchProjectDef[defName="SpacerFurniture"]</xpath>
			<value>
				<prerequisites>
					<li>MF_ModernFurniture</li>
					<li>Genesis_ClothBeds</li>
				</prerequisites>
			</value>
		</nomatch>
	</Operation>
</Patch>