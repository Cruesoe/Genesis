<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- VFE Classical crafting bench research follows the tables chain; the bench itself still needs that research -->
  <Operation Class="PatchOperationRemove">
    <success>Always</success>
    <xpath>/Defs/ResearchProjectDef[defName="VFEC_CraftingBench"]/prerequisites</xpath>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ResearchProjectDef[defName="VFEC_CraftingBench"]</xpath>
    <value>
      <prerequisites>
        <li>Genesis_Tables</li>
      </prerequisites>
    </value>
  </Operation>
</Patch>
