<!-- Hunter drone gates the military drone branches when Odyssey is active. -->
<Operation Class="PatchOperationFindMod">
    <mods>
        <li>Odyssey</li>
    </mods>
    <match Class="PatchOperationReplace">
        <xpath>Defs/ResearchProjectDef[defName="Genesis_BattleDrone"]/prerequisites</xpath>
        <value>
            <prerequisites>
                <li>HunterDrones</li>
            </prerequisites>
        </value>
    </match>
</Operation>


</Patch>
