<?xml version="1.0" encoding="utf-8" ?>
<Patch>              
<!-- VFEM2 PATCHES -->

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="VFEM2_AilmentsShelf"]/researchPrerequisites</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="VFEM2_AilmentsShelf"]/researchPrerequisites</xpath>
      <value>
        <researchPrerequisites Inherit="false">
          <li>Genesis_Shelves</li>
        </researchPrerequisites>
      </value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="VFEM2_AilmentsShelf"]</xpath>
      <value>
        <researchPrerequisites Inherit="false">
          <li>Genesis_Shelves</li>
        </researchPrerequisites>
      </value>
    </nomatch>
  </Operation>

</Patch>
