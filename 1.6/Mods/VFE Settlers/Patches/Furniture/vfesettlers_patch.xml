<?xml version="1.0" encoding="utf-8" ?>
<Patch>              

<!-- Ferny_Tables research prerequisites -->

                <Operation Class="PatchOperationConditional">
                  <xpath>/Defs/ThingDef[defName="TableCircular"]/researchPrerequisites</xpath>
                  <match Class="PatchOperationReplace">
                    <xpath>/Defs/ThingDef[defName="TableCircular"]/researchPrerequisites</xpath>
                    <value>
                      <researchPrerequisites Inherit="False">
                        <li>Ferny_Tables</li>
                      </researchPrerequisites> 
                   </value>
                  </match>
                  <nomatch Class="PatchOperationAdd">
                    <xpath>/Defs/ThingDef[defName="TableCircular"]</xpath>
                    <value>
                      <researchPrerequisites Inherit="False">
                        <li>Ferny_Tables</li>
                      </researchPrerequisites> 
                    </value>
                  </nomatch>
                </Operation>

</Patch>