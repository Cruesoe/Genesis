<?xml version="1.0" encoding="utf-8" ?>
<Patch>              
    <Operation Class="PatchOperationReplace">
        <success>Always</success>
        <xpath>Defs/ThingDef[defName="VFEArch_HedgeWall"]/label</xpath>
        <value>
            <label>trimmed hedge</label>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <success>Always</success>
        <xpath>Defs/ThingDef[defName="VFEArch_FineWall"]/label</xpath>
        <value>
            <label>pretty wall</label>
        </value>
    </Operation>

	<Operation Class="PatchOperationConditional">
		<xpath>/Defs/ThingDef[defName="VFEArch_FineWall"]/researchPrerequisites</xpath>
		<match Class="PatchOperationReplace">
			<xpath>/Defs/ThingDef[defName="VFEArch_FineWall"]/researchPrerequisites</xpath>
			<value>
				<researchPrerequisites>
					<li>Genesis_Column</li>
				</researchPrerequisites>
			</value>
		</match>
		<nomatch Class="PatchOperationAdd">
			<xpath>/Defs/ThingDef[defName="VFEArch_FineWall"]</xpath>
			<value>
				<researchPrerequisites>
					<li>Genesis_Column</li>
				</researchPrerequisites>
			</value>
		</nomatch>
	</Operation>

</Patch>