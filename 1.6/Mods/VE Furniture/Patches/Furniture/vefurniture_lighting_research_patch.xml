<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<Operation Class="PatchOperationRemove">
		<success>Always</success>
		<xpath>/Defs/ThingDef[defName="VFE_DeskLamp"]/researchPrerequisites</xpath>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>/Defs/ThingDef[defName="VFE_DeskLamp"]</xpath>
		<value>
			<researchPrerequisites Inherit="False">
				<li>Genesis_StandingLamp</li>
				<li MayRequire="oskarpotocki.vfe.tribals">VFET_Furniture</li>
				<li>Smithing</li>
			</researchPrerequisites>
		</value>
	</Operation>
	<Operation Class="PatchOperationRemove">
		<success>Always</success>
		<xpath>/Defs/ThingDef[defName="VFE_RoyalLamp"]/researchPrerequisites</xpath>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>/Defs/ThingDef[defName="VFE_RoyalLamp"]</xpath>
		<value>
			<researchPrerequisites Inherit="False">
				<li>Genesis_StandingLamp</li>
				<li>MF_RoyalFurniture</li>
			</researchPrerequisites>
		</value>
	</Operation>
</Patch>
