<?xml version="1.0" encoding="utf-8" ?>
<Patch>

  <!-- Node Research: mark the first cooking projects as research foundations -->
  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/ResearchProjectDef[defName="Ferny_FueledStove" or defName="Ferny_SimpleMeals"]</xpath>
    <value>
      <li Class="BetterResearchMenu.ResearchFoundationExtension"></li>
    </value>
  </Operation>

</Patch>
