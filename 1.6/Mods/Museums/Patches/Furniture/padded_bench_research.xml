<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<Operation Class="PatchOperationRemove">
		<success>Always</success>
		<xpath>/Defs/ThingDef[defName="Museums_Bench_Small" or defName="Museums_Bench_Medium" or defName="Museums_Bench_Large"]/researchPrerequisites</xpath>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>/Defs/ThingDef[defName="Museums_Bench_Small" or defName="Museums_Bench_Medium" or defName="Museums_Bench_Large"]</xpath>
		<value>
			<researchPrerequisites Inherit="False">
				<li>Ferny_Couches</li>
			</researchPrerequisites>
		</value>
	</Operation>
</Patch>
