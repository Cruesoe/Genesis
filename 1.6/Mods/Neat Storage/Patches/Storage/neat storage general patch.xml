<!-- VE FURNITURE -->
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Vanilla Furniture Expanded</li>
		</mods>
            <match Class="PatchOperationSequence">
                <operations>
                    <li Class="PatchOperationReplace">
                        <xpath>Defs/ThingDef[defName="Shelf_WeaponRack"]/label</xpath>
                        <value>
                            <label>small weapon rack</label>
                        </value>
                    </li>
                    <li Class="PatchOperationReplace">
                        <xpath>Defs/ThingDef[@Name="sbzWeaponRackBase"]/costStuffCount</xpath>
                        <value>
                            <costStuffCount>50</costStuffCount>
                        </value>
                    </li>
                </operations>
            </match>
	</Operation>






<!-- REEL -->
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Reel's Expanded Storage</li>
		</mods>
            <match Class="PatchOperationSequence">
                <operations>
                    <li Class="PatchOperationReplace">
                        <xpath>Defs/ThingDef[@Name="sbzCrateBase"]/researchPrerequisites</xpath>
                        <value>
                            <researchPrerequisites>
                                <li>Ferny_Boxes</li>
                            </researchPrerequisites>
                        </value>
                    </li>
                    <li Class="PatchOperationReplace">
                        <xpath>Defs/ThingDef[@Name="sbzDisplayShelfBase"]/researchPrerequisites</xpath>
                        <value>
                            <researchPrerequisites>
                                <li>Ferny_Shelves</li>
                            </researchPrerequisites>
                        </value>
                    </li>
                    <li Class="PatchOperationReplace">
                        <xpath>Defs/ThingDef[@Name="sbzSmallDisplayShelfBase"]/researchPrerequisites</xpath>
                        <value>
                            <researchPrerequisites>
                                <li>Ferny_Shelves</li>
                            </researchPrerequisites>
                        </value>
                    </li>

                    <li Class="PatchOperationAdd">
                        <xpath>Defs/ThingDef[@Name="sbzWeaponRackBase"]</xpath>
                        <value>
                            <researchPrerequisites>
                                <li>ReelIndustrialStorage</li>
                            </researchPrerequisites>
                        </value>
                    </li>

                    <li Class="PatchOperationAdd">
                        <xpath>Defs</xpath>
                        <value>
							<VEF.Buildings.HiddenDesignatorsDef>
								<defName>FernyNeatStorageReelStorageProgStorage_HiddenDesignators</defName>
								<hiddenDesignators>
									<li>sbz_MeatHook</li>
                                    <li>ReelNewIndustrialShelf</li>
                                    <li>sbz_WeaponRack</li>
                                    <li>sbz_HorizontalWeaponRack</li>
                                    <li>sbz_VerticalWeaponRack</li>
                                    <li>sbz_SmallCrate</li>
                                    <li>sbz_Crate</li>
								</hiddenDesignators>
							</VEF.Buildings.HiddenDesignatorsDef>
                        </value>
                    </li>
                </operations>
            </match>
	</Operation>


<!-- MEDIEVAL OVERHAUL -->
	

	<!-- Drum research -->
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="sbz_Drum"]/researchPrerequisites</xpath>
		<match Class="PatchOperationReplace">
			<xpath>Defs/ThingDef[defName="sbz_Drum"]/researchPrerequisites</xpath>
			<value>
				<researchPrerequisites Inherit="false">
					<li>Machining</li>
					<li MayRequire="reel.expanded.storage">ReelIndustrialStorage</li>
				</researchPrerequisites>
			</value>
		</match>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="sbz_Drum"]</xpath>
			<value>
				<researchPrerequisites Inherit="false">
					<li>Machining</li>
					<li MayRequire="reel.expanded.storage">ReelIndustrialStorage</li>
				</researchPrerequisites>
			</value>
		</nomatch>
	</Operation>

