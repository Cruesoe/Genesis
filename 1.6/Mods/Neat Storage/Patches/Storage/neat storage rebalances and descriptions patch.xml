<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!-- Research: crates to Crates and chests, display shelves to Basic storage -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[@Name="sbzCrateBase"]/researchPrerequisites</xpath>
		<value>
			<researchPrerequisites>
				<li>Genesis_Boxes</li>
			</researchPrerequisites>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[@Name="sbzDisplayShelfBase"]/researchPrerequisites</xpath>
		<value>
			<researchPrerequisites>
				<li>Genesis_Shelves</li>
			</researchPrerequisites>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[@Name="sbzSmallDisplayShelfBase"]/researchPrerequisites</xpath>
		<value>
			<researchPrerequisites>
				<li>Genesis_Shelves</li>
			</researchPrerequisites>
		</value>
	</Operation>
	<!-- Crate base: 6 to 8 stacks/tile -->
	<!-- Original maxItemsInCell: 6 -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[@Name="sbzCrateBase"]/building/maxItemsInCell</xpath>
		<value>
			<maxItemsInCell>8</maxItemsInCell>
		</value>
	</Operation>
	<!-- Specialized industrial: to 15 stacks/tile -->
	<!-- <Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="sbz_TextileRack"]/building/maxItemsInCell</xpath>
		<value>
			<maxItemsInCell>15</maxItemsInCell>
		</value>
	</Operation> -->
	<!-- Original maxItemsInCell: 6 -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="sbz_Safe"]/building/maxItemsInCell</xpath>
		<value>
			<maxItemsInCell>18</maxItemsInCell>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="sbz_Safe"]/statBases/MaxHitPoints</xpath>
		<value>
			<MaxHitPoints>5000</MaxHitPoints>
		</value>
	</Operation>
	<Operation Class="PatchOperationConditional">
		<success>Always</success>
		<xpath>Defs/ThingDef[defName="sbz_Safe"]/stuffCategories</xpath>
		<match Class="PatchOperationReplace">
			<xpath>Defs/ThingDef[defName="sbz_Safe"]/stuffCategories</xpath>
			<value>
				<stuffCategories>
					<li>Metallic</li>
				</stuffCategories>
			</value>
		</match>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="sbz_Safe"]</xpath>
			<value>
				<stuffCategories>
					<li>Metallic</li>
				</stuffCategories>
			</value>
		</nomatch>
	</Operation>
	<Operation Class="PatchOperationConditional">
		<success>Always</success>
		<xpath>Defs/ThingDef[defName="sbz_Safe"]/costStuffCount</xpath>
		<match Class="PatchOperationReplace">
			<xpath>Defs/ThingDef[defName="sbz_Safe"]/costStuffCount</xpath>
			<value>
				<costStuffCount>200</costStuffCount>
			</value>
		</match>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="sbz_Safe"]</xpath>
			<value>
				<costStuffCount>200</costStuffCount>
			</value>
		</nomatch>
	</Operation>
	<Operation Class="PatchOperationConditional">
		<success>Always</success>
		<xpath>Defs/ThingDef[defName="sbz_Safe"]/costList</xpath>
		<match Class="PatchOperationRemove">
			<xpath>Defs/ThingDef[defName="sbz_Safe"]/costList</xpath>
		</match>
	</Operation>
	<!-- Original maxItemsInCell: 6 -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="sbz_Drum"]/building/maxItemsInCell</xpath>
		<value>
			<maxItemsInCell>15</maxItemsInCell>
		</value>
	</Operation>
	<!-- Pallets: restore source total capacities via 6 stacks/tile -->
	<!-- Original maxItemsInCell: 6 (inherited from sbzCrateBase) -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="sbz_MiniPallet"]</xpath>
		<value>
			<building>
				<maxItemsInCell>6</maxItemsInCell>
			</building>
		</value>
	</Operation>
	<!-- Original maxItemsInCell: 6 (inherited from sbzCrateBase) -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="sbz_HalfPallet"]</xpath>
		<value>
			<building>
				<maxItemsInCell>6</maxItemsInCell>
			</building>
		</value>
	</Operation>
	<!-- Original maxItemsInCell: 6 (inherited from sbzCrateBase) -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="sbz_Pallet"]</xpath>
		<value>
			<building>
				<maxItemsInCell>6</maxItemsInCell>
			</building>
		</value>
	</Operation>
	<!-- Filters -->
	<!-- Crate: Root minus Foods, FoodMeals, Corpses, Chunks -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="sbz_MidCrate"]</xpath>
		<value>
			<building>
				<fixedStorageSettings>
					<filter>
						<disallowNotEverStorable>true</disallowNotEverStorable>
						<categories Inherit="False">
							<li>Root</li>
						</categories>
						<disallowedCategories Inherit="False">
							<li>Foods</li>
							<li>FoodMeals</li>
							<li>Corpses</li>
							<li>Chunks</li>
						</disallowedCategories>
					</filter>
				</fixedStorageSettings>
			</building>
		</value>
	</Operation>
	<!-- Pallets: unrestricted -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="sbz_MiniPallet"]</xpath>
		<value>
			<building>
				<fixedStorageSettings>
					<filter>
						<disallowNotEverStorable>true</disallowNotEverStorable>
						<categories Inherit="False">
							<li>Root</li>
						</categories>
					</filter>
				</fixedStorageSettings>
			</building>
		</value>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="sbz_HalfPallet"]</xpath>
		<value>
			<building>
				<fixedStorageSettings>
					<filter>
						<disallowNotEverStorable>true</disallowNotEverStorable>
						<categories Inherit="False">
							<li>Root</li>
						</categories>
					</filter>
				</fixedStorageSettings>
			</building>
		</value>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="sbz_Pallet"]</xpath>
		<value>
			<building>
				<fixedStorageSettings>
					<filter>
						<disallowNotEverStorable>true</disallowNotEverStorable>
						<categories Inherit="False">
							<li>Root</li>
						</categories>
					</filter>
				</fixedStorageSettings>
			</building>
		</value>
	</Operation>
	<!-- Safe: only metallic-category items -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="sbz_Safe"]/building/fixedStorageSettings/filter</xpath>
		<value>
			<filter>
				<disallowNotEverStorable>true</disallowNotEverStorable>
				<categories Inherit="False">
					
				</categories>
			</filter>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="sbz_Safe"]/building/defaultStorageSettings/filter</xpath>
		<value>
			<filter>
				<disallowNotEverStorable>true</disallowNotEverStorable>
				<categories Inherit="False">
					
				</categories>
			</filter>
		</value>
	</Operation>
	<!-- Drum: restrict to ResourcesRaw, Foods -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="sbz_Drum"]/building/fixedStorageSettings/filter</xpath>
		<value>
			<filter>
				<disallowNotEverStorable>true</disallowNotEverStorable>
				<categories Inherit="False">
					<li>ResourcesRaw</li>
					<li>Foods</li>
				</categories>
			</filter>
		</value>
	</Operation>
	<!-- Descriptions -->
