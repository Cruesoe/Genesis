<?xml version="1.0" encoding="utf-8" ?>
<Patch>

	<Operation Class="PatchOperationConditional">
		<xpath>/Defs/ThingDef[defName="RoseTea"]/recipeMaker/researchPrerequisite</xpath>
		<match Class="PatchOperationReplace">
			<xpath>/Defs/ThingDef[defName="RoseTea"]/recipeMaker/researchPrerequisite</xpath>
			<value>
				<researchPrerequisite>VFET_Agriculture</researchPrerequisite>
			</value>
		</match>
		<nomatch Class="PatchOperationAdd">
			<xpath>/Defs/ThingDef[defName="RoseTea"]/recipeMaker</xpath>
			<value>
				<researchPrerequisite>VFET_Agriculture</researchPrerequisite>
			</value>
		</nomatch>
	</Operation>

</Patch>
