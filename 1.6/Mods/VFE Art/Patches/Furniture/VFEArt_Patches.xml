	<Operation Class="PatchOperationSequence">
		<success>Always</success>
		<operations>
			<li Class="PatchOperationRemove">
				<xpath>/Defs/ThingDef[@Name="RugBase"]/recipeMaker</xpath>
			</li>
			<li Class="PatchOperationConditional">
				<xpath>/Defs/ThingDef[@Name="RugBase"]/designationCategory</xpath>
				<match Class="PatchOperationReplace">
					<xpath>/Defs/ThingDef[@Name="RugBase"]/designationCategory</xpath>
					<value>
						<designationCategory>Ferny_DecoRugs</designationCategory>
					</value>
				</match>
				<nomatch Class="PatchOperationAdd">
					<xpath>/Defs/ThingDef[@Name="RugBase"]</xpath>
					<value>
						<designationCategory>Ferny_DecoRugs</designationCategory>
					</value>
				</nomatch>
			</li>
			<li Class="PatchOperationConditional">
				<xpath>/Defs/ThingDef[@Name="RugBase"]/terrainAffordanceNeeded</xpath>
				<match Class="PatchOperationReplace">
					<xpath>/Defs/ThingDef[@Name="RugBase"]/terrainAffordanceNeeded</xpath>
					<value>
						<terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
					</value>
				</match>
				<nomatch Class="PatchOperationAdd">
					<xpath>/Defs/ThingDef[@Name="RugBase"]</xpath>
					<value>
						<terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
					</value>
				</nomatch>
			</li>
			<li Class="PatchOperationConditional">
				<xpath>/Defs/ThingDef[@Name="RugBase"]/researchPrerequisites</xpath>
				<match Class="PatchOperationReplace">
					<xpath>/Defs/ThingDef[@Name="RugBase"]/researchPrerequisites</xpath>
					<value>
						<researchPrerequisites>
							<li>VFE_Res_Rugs</li>
						</researchPrerequisites>
					</value>
				</match>
				<nomatch Class="PatchOperationAdd">
					<xpath>/Defs/ThingDef[@Name="RugBase"]</xpath>
					<value>
						<researchPrerequisites>
							<li>VFE_Res_Rugs</li>
						</researchPrerequisites>
					</value>
				</nomatch>
			</li>
			<li Class="PatchOperationConditional">
				<xpath>/Defs/ThingDef[defName="VFE_RugSmall"]/statBases/WorkToMake</xpath>
				<match Class="PatchOperationReplace">
					<xpath>/Defs/ThingDef[defName="VFE_RugSmall"]/statBases/WorkToMake</xpath>
					<value>
						<WorkToBuild>14000</WorkToBuild>
					</value>
				</match>
				<nomatch Class="PatchOperationAdd">
					<xpath>/Defs/ThingDef[defName="VFE_RugSmall"]/statBases</xpath>
					<value>
						<WorkToBuild>14000</WorkToBuild>
					</value>
				</nomatch>
			</li>
			<li Class="PatchOperationConditional">
				<xpath>/Defs/ThingDef[defName="VFE_RugLarge"]/statBases/WorkToMake</xpath>
				<match Class="PatchOperationReplace">
					<xpath>/Defs/ThingDef[defName="VFE_RugLarge"]/statBases/WorkToMake</xpath>
					<value>
						<WorkToBuild>32000</WorkToBuild>
					</value>
				</match>
				<nomatch Class="PatchOperationAdd">
					<xpath>/Defs/ThingDef[defName="VFE_RugLarge"]/statBases</xpath>
					<value>
						<WorkToBuild>32000</WorkToBuild>
					</value>
				</nomatch>
			</li>
			<li Class="PatchOperationConditional">
				<xpath>/Defs/ThingDef[defName="VFE_RugGrand"]/statBases/WorkToMake</xpath>
				<match Class="PatchOperationReplace">
					<xpath>/Defs/ThingDef[defName="VFE_RugGrand"]/statBases/WorkToMake</xpath>
					<value>
						<WorkToBuild>70000</WorkToBuild>
					</value>
				</match>
				<nomatch Class="PatchOperationAdd">
					<xpath>/Defs/ThingDef[defName="VFE_RugGrand"]/statBases</xpath>
					<value>
						<WorkToBuild>70000</WorkToBuild>
					</value>
				</nomatch>
			</li>
		</operations>
	</Operation>

