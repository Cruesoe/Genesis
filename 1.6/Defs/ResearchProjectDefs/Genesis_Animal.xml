<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Animal era: a hunter-gatherer start. VFE Tribals research projects, so its work and order locks (unlocksWorkTypes, unlocksWorkTags, unlocksDesignators) follow them and tribal gatherings feed them. -->
  <!-- Genesis.UnlocksItems lists items moved here from another VFE Tribals project; items keep the default destination of their old project otherwise (see Genesis_Supersede_VFETribals.xml). -->

  <VFETribals.TribalResearchProjectDef Name="Genesis_AnimalBase" Abstract="True">
    <techLevel>Animal</techLevel>
    <tab>Genesis_Tribal</tab>
    <baseCost>50</baseCost>
  </VFETribals.TribalResearchProjectDef>

  <VFETribals.TribalResearchProjectDef ParentName="Genesis_AnimalBase">
    <defName>Genesis_Fire</defName>
    <label>fire</label>
    <description>Make and keep fire, for warmth, light and cooking, and learn to put one out. Unlocks campfires, torches and firefighting.</description>
    <researchViewX>0.00</researchViewX>
    <researchViewY>1.60</researchViewY>
    <unlocksWorkTypes>
      <li>Firefighter</li>
    </unlocksWorkTypes>
    <unlocksWorkTags>Firefighting</unlocksWorkTags>
  </VFETribals.TribalResearchProjectDef>

  <VFETribals.TribalResearchProjectDef ParentName="Genesis_AnimalBase">
    <defName>Genesis_Hunting</defName>
    <label>hunting</label>
    <description>Track and bring down game, and butcher it for meat and hides. Unlocks hunting, the butcher spot and traps.</description>
    <researchViewX>1.00</researchViewX>
    <researchViewY>0.40</researchViewY>
    <prerequisites>
      <li>Genesis_Fire</li>
    </prerequisites>
    <unlocksWorkTypes>
      <li>Hunting</li>
    </unlocksWorkTypes>
    <unlocksDesignators>
      <li>Designator_Hunt</li>
    </unlocksDesignators>
  </VFETribals.TribalResearchProjectDef>

  <VFETribals.TribalResearchProjectDef ParentName="Genesis_AnimalBase">
    <defName>Genesis_Shelter</defName>
    <label>shelter</label>
    <description>Raise simple walls, doors and roofs against the weather. Unlocks walls, doors, straw matting and roofing.</description>
    <researchViewX>1.00</researchViewX>
    <researchViewY>2.40</researchViewY>
    <prerequisites>
      <li>Genesis_Fire</li>
    </prerequisites>
    <unlocksDesignators>
      <li>Designator_AreaBuildRoof</li>
      <li>Designator_RemoveFloor</li>
      <li>Designator_RemoveFoundation</li>
    </unlocksDesignators>
    <modExtensions>
      <li Class="Genesis.UnlocksItems">
        <items>
          <li>Wall</li>
          <li>Door</li>
          <li>GrayWall</li>
          <li>GrayDoor</li>
          <li>StrawMatting</li>
        </items>
      </li>
    </modExtensions>
  </VFETribals.TribalResearchProjectDef>

  <VFETribals.TribalResearchProjectDef ParentName="Genesis_AnimalBase">
    <defName>Genesis_Digging</defName>
    <label>digging</label>
    <description>Dig into earth and rock for stone and ore. Unlocks mining.</description>
    <researchViewX>1.00</researchViewX>
    <researchViewY>3.20</researchViewY>
    <prerequisites>
      <li>Genesis_Fire</li>
    </prerequisites>
    <unlocksWorkTypes>
      <li>Mining</li>
    </unlocksWorkTypes>
    <unlocksDesignators>
      <li>Designator_Mine</li>
    </unlocksDesignators>
  </VFETribals.TribalResearchProjectDef>

  <VFETribals.TribalResearchProjectDef ParentName="Genesis_AnimalBase">
    <defName>Genesis_StoneTools</defName>
    <label>stone tools</label>
    <description>Shape stone and wood into tools that also serve as weapons. Unlocks the club, knife, stake and hatchet.</description>
    <researchViewX>2.00</researchViewX>
    <researchViewY>0.80</researchViewY>
    <prerequisites>
      <li>Genesis_Hunting</li>
    </prerequisites>
  </VFETribals.TribalResearchProjectDef>

  <VFETribals.TribalResearchProjectDef ParentName="Genesis_AnimalBase">
    <defName>Genesis_Taming</defName>
    <label>taming</label>
    <description>Win the trust of wild animals and teach them to work alongside your people. Unlocks taming, animal handling and animal beds.</description>
    <researchViewX>2.00</researchViewX>
    <researchViewY>0.00</researchViewY>
    <prerequisites>
      <li>Genesis_Hunting</li>
    </prerequisites>
    <unlocksWorkTypes>
      <li>Handling</li>
    </unlocksWorkTypes>
    <unlocksDesignators>
      <li>Designator_Tame</li>
    </unlocksDesignators>
    <modExtensions>
      <li Class="Genesis.UnlocksItems">
        <items>
          <li>AnimalSleepingBox</li>
          <li>AnimalBed</li>
        </items>
      </li>
    </modExtensions>
  </VFETribals.TribalResearchProjectDef>

  <VFETribals.TribalResearchProjectDef ParentName="Genesis_AnimalBase">
    <defName>Genesis_HideClothing</defName>
    <label>hide clothing</label>
    <description>Turn the hides of the hunt into clothing, and adorn it with beads and bone. Unlocks tribalwear and simple adornments.</description>
    <researchViewX>2.00</researchViewX>
    <researchViewY>1.60</researchViewY>
    <prerequisites>
      <li>Genesis_Hunting</li>
    </prerequisites>
    <modExtensions>
      <li Class="Genesis.UnlocksItems">
        <items>
          <li>VIEHAR_Apparel_Beads</li>
          <li>VIEHAR_Apparel_DeerSkull</li>
          <li>VIEHAR_Apparel_HorseMask</li>
          <li>VIEHAR_Apparel_Rags</li>
        </items>
      </li>
    </modExtensions>
  </VFETribals.TribalResearchProjectDef>

  <VFETribals.TribalResearchProjectDef ParentName="Genesis_AnimalBase">
    <defName>Genesis_Bedding</defName>
    <label>bedding</label>
    <description>Sleep and sit on something better than bare ground. Unlocks bedrolls and sitting cushions.</description>
    <researchViewX>2.00</researchViewX>
    <researchViewY>2.40</researchViewY>
    <prerequisites>
      <li>Genesis_Shelter</li>
    </prerequisites>
    <modExtensions>
      <li Class="Genesis.UnlocksItems">
        <items>
          <li>Bedroll</li>
          <li>BedrollDouble</li>
          <li>Seat_Cushion</li>
        </items>
      </li>
    </modExtensions>
  </VFETribals.TribalResearchProjectDef>

  <VFETribals.TribalResearchProjectDef ParentName="Genesis_AnimalBase">
    <defName>Genesis_ThrowingWeapons</defName>
    <label>throwing weapons</label>
    <description>Strike from a distance with thrown stones and spikes. Unlocks throwing rocks and throwspikes.</description>
    <researchViewX>3.00</researchViewX>
    <researchViewY>0.50</researchViewY>
    <prerequisites>
      <li>Genesis_StoneTools</li>
    </prerequisites>
    <modExtensions>
      <li Class="Genesis.UnlocksItems">
        <items>
          <li>VWE_Throwing_Rocks</li>
          <li>VFET_Throwspikes</li>
        </items>
      </li>
    </modExtensions>
  </VFETribals.TribalResearchProjectDef>

  <VFETribals.TribalResearchProjectDef ParentName="Genesis_AnimalBase">
    <defName>Genesis_ShortBow</defName>
    <label>short bow</label>
    <description>Bend wood and sinew into a bow, the hunter's greatest tool. Unlocks the short bow.</description>
    <researchViewX>3.00</researchViewX>
    <researchViewY>1.10</researchViewY>
    <baseCost>70</baseCost>
    <prerequisites>
      <li>Genesis_StoneTools</li>
    </prerequisites>
  </VFETribals.TribalResearchProjectDef>

  <VFETribals.TribalResearchProjectDef ParentName="Genesis_AnimalBase">
    <defName>Genesis_Spirits</defName>
    <label>spirits</label>
    <description>Honour the spirits and the dead, and pass knowledge on around the fire. Unlocks effigies, drums, pyres and the research spot, and lets your people research.</description>
    <researchViewX>4.00</researchViewX>
    <researchViewY>1.60</researchViewY>
    <baseCost>100</baseCost>
    <prerequisites>
      <li>Genesis_Taming</li>
      <li>Genesis_ShortBow</li>
      <li>Genesis_HideClothing</li>
      <li>Genesis_Bedding</li>
    </prerequisites>
    <unlocksWorkTags>Intellectual</unlocksWorkTags>
    <modExtensions>
      <li Class="Genesis.UnlocksItems">
        <items>
          <li>Effigy</li>
          <li>Drum</li>
          <li>Pyre</li>
          <li>Skullspike</li>
          <li>SacrificialFlag</li>
          <li>Burnbong</li>
          <li>VME_Bonfire</li>
          <li>VME_WickerMan</li>
          <li>VFET_ResearchSpot</li>
        </items>
      </li>
    </modExtensions>
  </VFETribals.TribalResearchProjectDef>

</Defs>
