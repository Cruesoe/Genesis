<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- Progression: Arsenal's platform research requires Floors -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ResearchProjectDef[defName="Ferny_Platform"]</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ResearchProjectDef[defName="Ferny_Platform"]/prerequisites</xpath>
      <value>
        <prerequisites>
          <li>Ferny_Floors</li>
        </prerequisites>
      </value>
    </match>
  </Operation>

</Patch>
