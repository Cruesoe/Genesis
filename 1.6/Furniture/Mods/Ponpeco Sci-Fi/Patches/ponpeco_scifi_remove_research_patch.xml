                    <xpath>/Defs/ThingDef/researchPrerequisites/li[text()="PFS_ResearchProject"]</xpath>
                </match>
            </li>

            <li Class="PatchOperationConditional">
                <success>Always</success>
                <xpath>/Defs/TerrainDef/researchPrerequisites/li[text()="PFS_ResearchProject"]</xpath>
