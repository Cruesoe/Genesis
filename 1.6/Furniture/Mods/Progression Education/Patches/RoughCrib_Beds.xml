<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Loads with Education: the rough crib folds into Beds -->
  <Operation Class="PatchOperationSequence">
    <operations>
      <li Class="PatchOperationReplace">
        <success>Always</success>
        <xpath>Defs//*[self::researchPrerequisites or self::prerequisites or self::hiddenPrerequisites]/li[normalize-space(text())="Ferny_RoughCrib"]</xpath>
        <value>
          <li>Ferny_Bedroll</li>
        </value>
      </li>
      <li Class="PatchOperationRemove">
        <xpath>Defs/ResearchProjectDef[defName="Ferny_RoughCrib"]</xpath>
      </li>
    </operations>
  </Operation>
</Patch>
