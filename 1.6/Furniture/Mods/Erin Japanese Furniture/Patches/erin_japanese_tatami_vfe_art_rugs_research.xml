<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Vanilla Furniture Expanded - Art</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>

        <!-- Tatami (1x2) -->
        <li Class="PatchOperationConditional">
          <xpath>/Defs/ThingDef[defName="Erin_Tatami1x2c"]/researchPrerequisites</xpath>
          <match Class="PatchOperationReplace">
            <xpath>/Defs/ThingDef[defName="Erin_Tatami1x2c"]/researchPrerequisites</xpath>
            <value>
              <researchPrerequisites>
                <li>VFE_Res_Rugs</li>
              </researchPrerequisites>
            </value>
          </match>
          <nomatch Class="PatchOperationAdd">
            <xpath>/Defs/ThingDef[defName="Erin_Tatami1x2c"]</xpath>
            <value>
              <researchPrerequisites>
                <li>VFE_Res_Rugs</li>
              </researchPrerequisites>
            </value>
          </nomatch>
        </li>

        <!-- Tatami (1x3) -->
        <li Class="PatchOperationConditional">
          <xpath>/Defs/ThingDef[defName="Erin_Tatami1x3c"]/researchPrerequisites</xpath>
          <match Class="PatchOperationReplace">
            <xpath>/Defs/ThingDef[defName="Erin_Tatami1x3c"]/researchPrerequisites</xpath>
            <value>
              <researchPrerequisites>
                <li>VFE_Res_Rugs</li>
              </researchPrerequisites>
            </value>
          </match>
          <nomatch Class="PatchOperationAdd">
            <xpath>/Defs/ThingDef[defName="Erin_Tatami1x3c"]</xpath>
            <value>
              <researchPrerequisites>
                <li>VFE_Res_Rugs</li>
              </researchPrerequisites>
            </value>
          </nomatch>
        </li>

      </operations>
    </match>
  </Operation>
</Patch>
